<Project>
  <Target Name="CKTesting_CheckObsoleteMonitoringPackage"
          AfterTargets="ResolvePackageAssets"
          Condition="'$(CKTestingAllowObsoleteMonitoringPackage)' != 'true'">
    <ItemGroup>
      <_CKTestingObsoleteMonitoringPackage Include="@(PackageDependencies)"
                                           Condition="'%(Identity)' == 'CK.Testing.Monitoring'" />
    </ItemGroup>
    <Error Condition="'@(_CKTestingObsoleteMonitoringPackage)' != ''"
           Code="CKTESTING001"
           Text="CK.Testing.Monitoring is obsolete: use CK.Testing. Remove the CK.Testing.Monitoring package reference, or update the package that brings it transitively. Set the property CKTestingAllowObsoleteMonitoringPackage to true to skip this check." />
  </Target>
</Project>
