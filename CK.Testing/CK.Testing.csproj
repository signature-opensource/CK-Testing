<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Contains the Monitor Test Helper. Shouldly is used for assertions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CK.Core" Version="26.0.1" />
    <PackageReference Include="CK.Monitoring" Version="27.1.0" />
    <PackageReference Include="CK.ActivityMonitor.SimpleSender" Version="27.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CK.Testing.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fails the build of a consumer that also has the obsolete CK.Testing.Monitoring package (it contains types of this package). -->
    <None Include="buildTransitive/CK.Testing.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>
