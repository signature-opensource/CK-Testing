<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Contains Test Helpers mixin infrastructure and the Monitor Test Helper. Shouldly is used for assertions.</Description>
    <LangVersion>11</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CK.Core" Version="26.0.0" />
    <PackageReference Include="CK.Monitoring" Version="27.0.1-mike.0.ci.1" />
    <PackageReference Include="CK.ActivityMonitor.SimpleSender" Version="27.0.1-mike.0.ci.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CK.Testing.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Fails the build of a consumer that also has the obsolete CK.Testing.Monitoring package (its types are now here). -->
    <None Include="buildTransitive/CK.Testing.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>
