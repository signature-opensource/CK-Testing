<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CK.Testing.Monitoring is obsolete: use CK.Testing.
    This project produces the last version of the package (a "tombstone"): the package contains no assembly
    and has no dependency. Its buildTransitive targets file fails the build of any project that uses it,
    with a message that explains what to do.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Obsolete: use CK.Testing. This package contains no assembly. It fails the build with a message that explains what to do.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- NU5128: the package has a dependency group for net10.0 but no lib or ref folder. This is intended. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="buildTransitive/CK.Testing.Monitoring.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>
</Project>
